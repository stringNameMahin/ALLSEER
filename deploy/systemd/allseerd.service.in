[Unit]
Description=ALLSEER governance daemon for AI coding agents
After=local-fs.target

[Service]
Type=simple
ExecStart=@BINDIR@/allseerd --config @SYSCONFDIR@/allseerd.yaml
# A crash leaves the agents it governed running. The restarted daemon freezes
# them at startup; allseerctl leftovers lists, thaws or kills them.
Restart=on-failure
RestartSec=1
# The daemon ends its sessions on SIGTERM, within daemon.shutdown_grace.
TimeoutStopSec=45
RuntimeDirectory=allseer
RuntimeDirectoryMode=0755
StateDirectory=allseer
StateDirectoryMode=0700
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
