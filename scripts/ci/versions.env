# Pinned CI tool versions. Read by the Makefile, scripts/ci/tools.sh and the
# workflow cache keys, so a bump here reaches every consumer.
GOLANGCI_LINT_VERSION=v2.5.0
GOVULNCHECK_VERSION=v1.8.0
GITLEAKS_VERSION=v8.30.1
ACTIONLINT_VERSION=v1.7.12
CHECK_JSONSCHEMA_VERSION=0.38.1

SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_AARCH64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588

BPFTOOL_VERSION=v7.7.0
BPFTOOL_SHA256_AMD64=09150596f09356b0ff632dd7f9856e0ea86bf96b269e9bc94278d9a9432a268c
BPFTOOL_SHA256_ARM64=d68443d945c146080151eb215bebaa400294ab7ada22af4f5d0a940f5992b9d9

# Must match the libbpf named in the libbpfgo version in go.mod.
LIBBPF_VERSION=v1.5.1
LIBBPF_COMMIT=b4fa3e39a77fd65574fb5f899486795fc3d89bd9

# Headers compiled into the BPF object only, not linked. The 1.5.1 CO-RE
# macros keep const qualifiers that clang 21 rejects under -Werror, and 1.6.x
# declares a bpf_stream_vprintk that clashes with vmlinux.h on newer kernels.
LIBBPF_BPF_HEADERS_VERSION=v1.7.0
LIBBPF_BPF_HEADERS_COMMIT=f5dcbae736e5d7f83a35718e01be1a8e3010fa39
